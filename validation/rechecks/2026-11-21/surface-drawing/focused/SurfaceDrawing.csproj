<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <IsPackable>false</IsPackable><AssemblyName>OpticalSystemDesign.Tests</AssemblyName>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\..\..\..\</RepositoryRoot>
    <OutputPath Condition="'$(SurfaceTestOutputRoot)' != ''">$(SurfaceTestOutputRoot)\drawing\$(Configuration)\</OutputPath>
    <CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>true</CreateHardLinksForCopyFilesToOutputDirectoryIfPossible>
    <CreateHardLinksForCopyLocalIfPossible>true</CreateHardLinksForCopyLocalIfPossible>
    <CreateHardLinksForCopyAdditionalFilesIfPossible>true</CreateHardLinksForCopyAdditionalFilesIfPossible>
    <CreateHardLinksForAdditionalFilesIfPossible>true</CreateHardLinksForAdditionalFilesIfPossible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="$(RepositoryRoot)src\OpticalSystemDesign.App\OpticalSystemDesign.App.csproj" />
    <Compile Include="$(RepositoryRoot)tests\Shared\SafeHeadlessUnitTestSession.cs" Link="SafeHeadlessUnitTestSession.cs" />
    <Compile Include="$(RepositoryRoot)tests\OpticalSystemDesign.Tests\SurfaceDrawingSettingsTests.cs" Link="SurfaceDrawingSettingsTests.cs" />
    <Compile Include="$(RepositoryRoot)tests\OpticalSystemDesign.Tests\SurfaceDrawingPanelTests.cs" Link="SurfaceDrawingPanelTests.cs" />
    <Compile Include="$(RepositoryRoot)tests\OpticalSystemDesign.Tests\SurfaceDrawingRenderTests.cs" Link="SurfaceDrawingRenderTests.cs" />
    <Compile Include="$(RepositoryRoot)tests\OpticalSystemDesign.Tests\SurfaceColorTests.cs" Link="SurfaceColorTests.cs" />
  </ItemGroup>
</Project>
