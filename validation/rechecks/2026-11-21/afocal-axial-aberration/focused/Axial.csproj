<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>OpticalSystemDesign.Tests</AssemblyName><IsPackable>false</IsPackable>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\..\..\..\</RepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="$(RepositoryRoot)src/OpticalSystemDesign.Core/OpticalSystemDesign.Core.csproj" />
    <Compile Include="$(RepositoryRoot)tests/OpticalSystemDesign.Tests/AxialAberrationAnalysisTests.cs" Link="AxialAberrationAnalysisTests.cs" />
    <Compile Include="$(RepositoryRoot)tests/OpticalSystemDesign.Tests/AfocalAxialAberrationTests.cs" Link="AfocalAxialAberrationTests.cs" />
  </ItemGroup>
</Project>
