<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>OpticalSystemDesign.Tests</AssemblyName>
    <RepositoryRoot>$(MSBuildThisFileDirectory)..\..\..\..\..\</RepositoryRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <Using Include="Xunit" />
    <ProjectReference Include="$(RepositoryRoot)src\OpticalSystemDesign.App\OpticalSystemDesign.App.csproj" />
    <Compile Include="$(RepositoryRoot)tests\OpticalSystemDesign.Tests\UserGuidePanelTests.cs" Link="UserGuidePanelTests.cs" />
    <Compile Include="$(RepositoryRoot)tests\OpticalSystemDesign.Tests\UserGuideMathematicsTests.cs" Link="UserGuideMathematicsTests.cs" />
    <Compile Include="$(RepositoryRoot)tests\Shared\SafeHeadlessUnitTestSession.cs" Link="SafeHeadlessUnitTestSession.cs" />
  </ItemGroup>
</Project>
