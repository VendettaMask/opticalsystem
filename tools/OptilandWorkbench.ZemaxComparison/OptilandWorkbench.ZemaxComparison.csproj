<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <ProjectReference Include="../../src/OptilandWorkbench.Application/OptilandWorkbench.Application.csproj" />
    <Compile Remove="ZemaxHost/**/*.cs" />
    <None Include="comparison-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ZemaxHost/*.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="assets/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
