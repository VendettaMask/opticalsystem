    <Reference Include="OpticalSystemDesign.InitialStructure.Contracts"><HintPath>$(FrozenRuntime)/OpticalSystemDesign.InitialStructure.Contracts.dll</HintPath></Reference>
    <Reference Include="OpticalSystemDesign.InitialStructure.Engine"><HintPath>$(FrozenRuntime)/OpticalSystemDesign.InitialStructure.Engine.dll</HintPath></Reference>
    <Reference Include="OpticalSystemDesign.InitialStructure.Persistence"><HintPath>$(FrozenRuntime)/OpticalSystemDesign.InitialStructure.Persistence.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="RequireFrozenRuntime" BeforeTargets="ResolveReferences" Condition="'$(FrozenRuntime)' == ''"><Error Text="Set FrozenRuntime to the immutable paired study runtime." /></Target>
</Project>
