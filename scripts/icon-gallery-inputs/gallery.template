<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>软件实际使用的全部图标</title>
<style>
:root{--surface:#151311;--text:#F4ECE5;--muted:#C8BBAF;--border:#44382F;--structure:#A5978B;--signal:#F0AE79;--secondary:#D5B89C;color-scheme:dark}
*{box-sizing:border-box}body{margin:0;background:var(--surface);color:var(--text);font:15px/1.6 "Microsoft YaHei UI","Microsoft YaHei",sans-serif}main{max-width:1480px;margin:auto;padding:32px 36px 64px}a{color:var(--signal);text-underline-offset:4px}button,input,select{font:inherit}button,a,select,input{touch-action:manipulation}button,select,input{border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--text)}button,select{padding:8px 12px;cursor:pointer}button:hover,a.tile:hover{border-color:var(--signal)}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible{outline:2px solid var(--signal);outline-offset:3px}button:disabled{opacity:.4;cursor:default}.eyebrow{font-size:12px;letter-spacing:1.7px;color:var(--signal);margin:0 0 7px}h1{font-size:30px;letter-spacing:.2px;margin:0 0 6px;line-height:1.3}h2{font-size:19px;margin:0 0 9px}p{margin:0 0 12px}.muted{color:var(--muted)}.hero{display:flex;align-items:flex-start;justify-content:space-between;gap:24px}.hero-side{text-align:right;font-size:12px;color:var(--muted);padding-top:7px;flex-shrink:0}.stats{display:flex;gap:22px;flex-wrap:wrap;margin:18px 0 23px;font-size:13px;color:var(--muted)}.stats strong{color:var(--text);font-size:21px;font-weight:500;padding-right:5px}.toolbar{background:var(--surface);position:sticky;top:0;z-index:2;padding:14px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);margin-bottom:26px}.themes,.search-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.themes{margin-bottom:12px}.themes button{font-size:13px;padding:7px 12px}.themes button[aria-pressed=true]{color:var(--signal);border-color:var(--signal)}.theme-label{font-size:12px;color:var(--muted);margin-right:8px}.swatch{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--signal);margin-right:6px}.search-wrap{flex:1;min-width:180px;position:relative}.search-wrap input{width:100%;padding:9px 36px 9px 12px;font-size:14px}.clear{position:absolute;right:5px;top:5px;border:0;padding:2px 8px;color:var(--muted);font-size:18px}.search-row select{font-size:13px;max-width:210px}.overview-link{font-size:12px;margin-left:auto;white-space:nowrap}.tokens{font-family:Consolas,monospace;font-size:11px;letter-spacing:.2px;margin-left:auto;color:var(--muted)}.tokens b{font-size:10px;font-weight:400;margin-left:10px}.tokens i{display:inline-block;width:7px;height:7px;border-radius:2px;margin-right:4px}.icon{display:block;flex-shrink:0}.icon .structure{fill:none;stroke:var(--structure)}.icon .signal{fill:none;stroke:var(--signal)}.icon .secondary{fill:none;stroke:var(--secondary)}.icon .signal-fill{fill:var(--signal);stroke:none}.icon .secondary-fill{fill:var(--secondary);stroke:none}.icon .glyph{stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}.section-head{display:flex;gap:16px;justify-content:space-between;align-items:baseline}.section-head button{font-size:12px;padding:4px 10px}.mtf-note{font-size:13px;color:var(--muted);max-width:1100px;margin-bottom:14px}.mtf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.mtf-card{padding:12px 15px;display:flex;align-items:center;gap:13px;text-align:left;min-width:0}.mtf-card strong{display:block;font-size:14px;font-weight:400;line-height:1.4}.mtf-card code{display:block;font:10px/1.7 Consolas,monospace;color:var(--muted);margin-top:2px;overflow-wrap:anywhere}.mtf-card .status{margin-left:auto;font-size:10px;color:var(--muted);white-space:nowrap}.mtf-card .icon{width:29px;height:29px}.catalog-head{margin-top:32px;margin-bottom:15px;display:flex;gap:16px;flex-wrap:wrap;justify-content:space-between;align-items:center}.catalog-head h2{margin:0}.catalog-count{font-size:12px;color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(144px,1fr));gap:10px}.tile{min-height:148px;padding:16px 9px 11px;text-align:center;display:flex;flex-direction:column;align-items:center;border:1px solid var(--border);border-radius:8px;background:var(--surface);color:var(--text);overflow:hidden}.tile .icon{width:36px;height:36px;margin:2px auto 13px}.tile .name{font-size:12px;line-height:1.5;max-width:100%;overflow-wrap:anywhere}.tile .id{font:10px/1.45 Consolas,monospace;color:var(--muted);margin-top:4px;overflow-wrap:anywhere;max-width:100%}.tile .badge{font-size:9px;line-height:1.3;color:var(--signal);margin-top:auto;padding-top:8px}.tile .use{font-size:10px;color:var(--muted);line-height:1.4;margin-top:5px}.pager{display:flex;gap:12px;align-items:center;justify-content:center;margin-top:24px}.pager span{font-size:13px;color:var(--muted);min-width:120px;text-align:center}.pager button{font-size:13px;padding:7px 17px}.empty{padding:60px 12px;text-align:center;color:var(--muted);border:1px dashed var(--border);grid-column:1/-1}.foot{font-size:12px;color:var(--muted);border-top:1px solid var(--border);margin-top:32px;padding-top:18px;max-width:100%;overflow-wrap:anywhere}.foot p{margin-bottom:8px}.foot a{margin-right:14px}dialog{background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:12px;max-width:680px;width:calc(100% - 32px);padding:25px}dialog::backdrop{background:#0009}dialog h2{font-size:21px;padding-right:40px;overflow-wrap:anywhere}dialog code{font-size:12px;overflow-wrap:anywhere}dialog p{font-size:13px;color:var(--muted)}.dialog-close{position:absolute;right:13px;top:12px;padding:0 8px;font-size:24px;border:0}.sizes{display:flex;align-items:flex-end;justify-content:center;gap:34px;min-height:143px;padding:22px 8px;border:1px solid var(--border);border-radius:8px;margin:20px 0}.size{text-align:center;color:var(--muted);font-size:11px}.size .icon{margin:auto auto 13px}.detail-section{font-size:12px;margin:8px 0;color:var(--muted);overflow-wrap:anywhere}.detail-section strong{font-weight:400;color:var(--text)}.dialog-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:20px}.primary{border-color:var(--signal);color:var(--signal)}.toast{font-size:12px;color:var(--secondary);min-height:20px;margin-top:9px}.print-note{display:none}@media(max-width:800px){main{padding:22px 18px 44px}.hero-side,.tokens{display:none}h1{font-size:25px}.mtf-grid{grid-template-columns:1fr 1fr}.mtf-card{padding:10px}.mtf-card strong{font-size:12px}.mtf-card .status{display:none}.themes{gap:5px}.themes button{padding:6px 8px;font-size:11px}.theme-label{display:none}.stats{gap:15px}.overview-link{margin-left:0}.toolbar{margin-bottom:20px}.sizes{gap:24px}.mtf-note{font-size:12px}}@media(max-width:470px){.mtf-grid{grid-template-columns:1fr}.hero h1{font-size:23px}.mtf-card .icon{width:26px;height:26px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.stats{font-size:11px;gap:12px}.stats strong{font-size:18px}.search-row select{max-width:150px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}@media print{.toolbar,.pager,.dialog,.foot{display:none}main{max-width:none}.print-note{display:block}.tile{break-inside:avoid}}
</style>
</head>
<body>
<main>
<header class="hero"><div><p class="eyebrow">OPTICAL SCIENTIFIC OUTLINE / 1.1</p><h1>软件实际使用的全部图标</h1><p class="muted" style="font-size:13px;margin-top:9px">按实际界面绑定筛选，包含下拉菜单、页面工具、弹窗及内置模块的全部功能图标。</p></div><div class="hero-side">2026.11.03<br>界面引用及切换状态 · 五主题 SVG<br>透明背景 · 离线可用</div></header>
<div class="stats"><span><strong id="total-icons"></strong>种实际用图</span><span><strong id="total-sites"></strong>处界面引用与状态</span><span><strong>5</strong>个主题</span><span><strong id="total-variants"></strong>份 SVG</span></div>
<div class="toolbar"><div class="themes" role="group" aria-label="主题配色"><span class="theme-label">主题</span><div id="theme-buttons" style="display:contents"></div><span class="tokens" id="tokens"></span></div><div class="search-row"><div class="search-wrap"><input id="search" type="search" placeholder="搜索图标 ID 或已识别的中文功能，例如：MTF、保存、布局" aria-label="搜索图标" autocomplete="off"><button class="clear" id="clear" title="清空搜索" aria-label="清空搜索" hidden>×</button></div><select id="filter" aria-label="所在界面"><option value="all">所有界面</option><option value="approved">专用确认稿</option><option value="mtf">MTF 菜单</option><optgroup id="place-options" label="按所在界面"></optgroup></select><select id="mode" aria-label="显示方式"><option value="functions">按功能展开</option><option value="shapes">按图形去重</option></select><a class="overview-link" id="overview" href="overview/used-icons-Dark.svg" download>下载全部实际用图 SVG 总图 ↗</a></div></div>
<details style="margin-bottom:20px"><summary style="cursor:pointer;color:var(--muted);font-size:13px">截图中的 MTF 菜单 · 9 项实际映射（展开）</summary><section aria-labelledby="mtf-heading" style="padding-top:16px"><div class="section-head"><h2 id="mtf-heading">截图中的 MTF 菜单 · 9 项</h2><button id="mtf-filter">只看这些图形</button></div><p class="mtf-note">这 9 项已统一线宽和主题配色，当前共用 5 种通用图形。“离焦”三项共用扫描线，“随视场”三项共用折线图；尚未分别重画成九个专用图标。以下与当前源代码映射一致。</p><div id="mtf-grid" class="mtf-grid"></div></section>
</details><section aria-labelledby="catalog-heading"><div class="catalog-head"><h2 id="catalog-heading">实际使用的图标</h2><span class="catalog-count" id="count" role="status" aria-live="polite"></span></div><div id="grid" class="grid"></div><nav class="pager" aria-label="图库分页"><button id="prev">上一页</button><span id="page-status"></span><button id="next">下一页</button></nav></section>
<footer class="foot"><p>本页仅包含主程序和内置模块实际绑定的功能图标，已排除备用库中未使用项；包含菜单项、弹窗工具、动态切换状态与 7 个实际方向按钮。</p><p>“按功能展开”保留同一图形在各界面的用途；“按图形去重”展示完整图形集合。这里的使用范围来自当前界面代码，不采集你的操作记录。系统及控件模板绘制的符号、品牌标志沿用原资源。</p><p><a href="使用说明.txt">范围与使用说明</a><a href="实际使用位置.csv" download>全部使用位置 CSV</a><a href="theme-colors.json" download>主题色</a><a href="LUCIDE-LICENSE.txt">Lucide 许可</a></p><p>图形适配当前五主题，独立 SVG 为普通状态；应用另有禁用及宿主背景可读性处理。通用衍生稿保留 Lucide 来源，专用稿与原生视角立方体分别记录。</p></footer>
</main>
<dialog id="detail" aria-labelledby="detail-title"><button id="close" class="dialog-close" aria-label="关闭详情">×</button><h2 id="detail-title"></h2><p><code id="detail-id"></code></p><div class="sizes" id="sizes"></div><div id="detail-copy"></div><div class="dialog-actions"><button class="primary" id="download">下载当前主题 SVG</button><button id="copy-id">复制图标 ID</button></div><div class="toast" id="toast" role="status" aria-live="polite"></div></dialog>
<script type="application/json" id="catalog-data">/*__CATALOG__*/</script>
<script>
'use strict';
const data=JSON.parse(document.getElementById('catalog-data').textContent), byId=new Map(data.icons.map(i=>[i.id,i]));
const $=id=>document.getElementById(id), mtfIds=new Set(data.mtf.map(c=>c.icon));
let currentTheme='Dark',page=0,filtered=data.icons,selected=null;
const pageSize=96, esc=s=>String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function iconMarkup(item,size=32){return `<svg class="icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width="${size}" height="${size}" role="img" aria-label="${esc(item.label)}"><title>${esc(item.label)}</title>${item.bodiesByTheme?.[currentTheme]||item.body}</svg>`}
function applyTheme(key){const t=data.themes.find(t=>t.key===key);if(!t)return;currentTheme=key;for(const name of ['surface','text','muted','border','structure','signal','secondary'])document.documentElement.style.setProperty('--'+name,t[name]);document.documentElement.style.colorScheme=['Light','Pixel'].includes(key)?'light':'dark';document.querySelectorAll('[data-theme]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.theme===key)));$('tokens').innerHTML=['structure','signal','secondary'].map((k,i)=>`<b><i style="background:${t[k]}"></i>${['结构','主信息','辅助'][i]} ${t[k]}</b>`).join('');$('overview').href=`overview/used-icons-${key}.svg`;$('download').textContent=`下载${t.name.split(' · ')[0]} SVG`;render()}
for(const t of data.themes){const b=document.createElement('button');b.type='button';b.dataset.theme=t.key;b.setAttribute('aria-pressed',String(t.key===currentTheme));b.innerHTML=`<span class="swatch" style="background:${t.signal}"></span>${esc(t.name)}`;b.addEventListener('click',()=>applyTheme(t.key));$('theme-buttons').append(b)}
for(const c of data.mtf){const i=byId.get(c.icon),b=document.createElement('button');b.className='mtf-card';b.type='button';b.innerHTML=iconMarkup(i)+`<span><strong>${esc(c.label)}</strong><code>${esc(c.icon)}</code></span><span class="status">统一风格</span>`;b.addEventListener('click',()=>openDetail(i,c.label));$('mtf-grid').append(b)}
function search(){const q=$('search').value.trim().toLocaleLowerCase(),f=$('filter').value,expanded=$('mode').value==='functions';$('clear').hidden=!q;filtered=[];for(const i of data.icons){if(f==='approved'&&!i.approved||f==='mtf'&&!mtfIds.has(i.id))continue;const uses=i.uses.filter(u=>f==='mtf'?u.group==='分析 · MTF 曲线':['all','approved'].includes(f)||u.group===f);if(!uses.length)continue;if(expanded){for(const u of uses){if(q&&![i.id,i.label,u.label,u.group,i.meaning,i.function].join(' ').toLocaleLowerCase().includes(q))continue;filtered.push({...i,label:u.label,showGroup:u.group,displaySource:u.source,displayLine:u.line})}}else{if(q&&![i.id,i.label,i.meaning,i.function,...uses.flatMap(u=>[u.label,u.group])].join(' ').toLocaleLowerCase().includes(q))continue;filtered.push(i)}}if(expanded)filtered.sort((a,b)=>a.showGroup.localeCompare(b.showGroup,'zh-CN')||a.displaySource.localeCompare(b.displaySource)||a.displayLine-b.displayLine);page=0;render()}

function render(){const pages=Math.max(1,Math.ceil(filtered.length/pageSize)),start=page*pageSize,end=Math.min(start+pageSize,filtered.length);$('count').textContent=filtered.length?`找到 ${filtered.length.toLocaleString()} ${$('mode').value==='functions'?'处用法':'种图形'} · 显示 ${start+1}–${end}`:'没有匹配图标';$('grid').replaceChildren();if(!filtered.length)$('grid').innerHTML='<div class="empty">没有匹配图标，试试其他名称或清除筛选。</div>';for(const item of filtered.slice(start,end)){const b=document.createElement('button');b.type='button';b.className='tile';b.dataset.icon=item.id;b.innerHTML=iconMarkup(item,36)+`<span class="name">${esc(item.label)}</span>${item.label!==item.id?`<span class="id">${esc(item.id)}</span>`:''}${item.uses.length?`<span class="use">${esc(item.uses[0].label)}${item.uses.length>1?' 等 '+item.uses.length+' 项':''}</span>`:''}<span class="badge">${esc(item.showGroup||(item.native?'视角立方体':item.approved?'专用确认稿':'当前界面用图'))}</span>`;b.setAttribute('aria-label',`查看 ${item.label} / ${item.id}`);b.addEventListener('click',()=>openDetail(item));$('grid').append(b)}$('page-status').textContent=`第 ${page+1} / ${pages} 页`;$('prev').disabled=page===0;$('next').disabled=page+1>=pages}
function openDetail(item,label){selected=byId.get(item.id);$('detail-title').textContent=label||item.label;$('detail-id').textContent=item.id;$('sizes').innerHTML=[18,24,32,64].map(n=>`<div class="size">${iconMarkup(item,n)}<span>${n} px</span></div>`).join('');$('detail-copy').innerHTML=`<p class="detail-section"><strong>来源：</strong>${item.native?'当前原生视角立方体 · 保留实际强调面、镜像、色阶和透明度':item.approved?'先前确认的专用图形':'Lucide 1.25.0 / ISC · 保留功能几何，统一网格、描边及三种角色色'}</p>${item.function?`<p class="detail-section"><strong>功能：</strong>${esc(item.function)}</p>`:''}${item.meaning?`<p class="detail-section"><strong>语义：</strong>${esc(item.meaning)}</p>`:''}${item.uses.length?`<p class="detail-section"><strong>已识别用法：</strong>${item.uses.map(u=>esc(u.group+' · '+u.label)+'<br><small>'+esc(u.source+':'+u.line)+(u.requestedIcon?'<br>源名称 '+esc(u.requestedIcon)+' → 当前回退为问号图形':'')+'</small>').join('<br><br>')}</p>`:''}${mtfIds.has(item.id)?'<p class="detail-section"><strong>MTF 菜单：</strong>当前使用通用图形；统一了风格与主题色，尚未逐项专用重画。</p>':''}<p class="detail-section"><strong>源文件：</strong>${esc(item.source)}</p>`;$('toast').textContent='';if(!$('detail').open)$('detail').showModal()}
function standalone(item){const t=data.themes.find(t=>t.key===currentTheme),css=`.structure{fill:none;stroke:${t.structure}}.signal{fill:none;stroke:${t.signal}}.secondary{fill:none;stroke:${t.secondary}}.signal-fill{fill:${t.signal};stroke:none}.secondary-fill{fill:${t.secondary};stroke:none}.glyph{stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round}`;return `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32" role="img" aria-label="${esc(item.label)}"><title>${esc(item.label)}</title><style>${css}</style>${item.bodiesByTheme?.[currentTheme]||item.body}</svg>\n`}
$('download').addEventListener('click',()=>{if(!selected)return;const blob=new Blob([standalone(selected)],{type:'image/svg+xml;charset=utf-8'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=selected.id+'-'+currentTheme+'.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),3000);$('toast').textContent='已准备下载 '+a.download});
$('copy-id').addEventListener('click',async()=>{if(!selected)return;try{await navigator.clipboard.writeText(selected.id);$('toast').textContent='已复制 '+selected.id}catch{$('toast').textContent='图标 ID：'+selected.id}});
$('close').addEventListener('click',()=>$('detail').close());$('detail').addEventListener('click',e=>{if(e.target===$('detail')){const r=$('detail').getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)$('detail').close()}});
$('mode').addEventListener('change',search);$('search').addEventListener('input',search);$('filter').addEventListener('change',search);$('clear').addEventListener('click',()=>{$('search').value='';search();$('search').focus()});$('mtf-filter').addEventListener('click',()=>{$('filter').value='mtf';$('search').value='';search();$('catalog-heading').scrollIntoView({block:'center',behavior:'auto'})});
function move(delta){page+=delta;render();$('catalog-heading').scrollIntoView({block:'center',behavior:'auto'})}$('prev').addEventListener('click',()=>move(-1));$('next').addEventListener('click',()=>move(1));$('total-icons').textContent=data.counts.total;$('total-sites').textContent=data.counts.sites;$('total-variants').textContent=data.counts.variants;for(const name of data.groups){const o=document.createElement('option');o.value=name;o.textContent=name;$('place-options').append(o)}applyTheme(currentTheme);search();
</script>
</body>
</html>
