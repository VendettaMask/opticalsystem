<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OptilandWorkbench.Application\OptilandWorkbench.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" Version="12.0.0.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets/Icons/lucide-icon-nodes.json" />
    <AvaloniaResource Remove="Assets/Icons/game-icons-isekai.json" />
    <AvaloniaResource Remove="Assets/Icons/farm-fresh-icons.json" />
    <AvaloniaResource Remove="Assets/Icons/FarmFresh32/*.png" />
    <AvaloniaResource Include="Assets/Author.jpg" />
    <AvaloniaResource Include="Assets/Brand/AppIcon.png" />
    <AvaloniaResource Include="Assets/Brand/Splash.png" />
    <Content Include="Assets/Brand/AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/Splash.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/AppIcon.icns" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/LensLibrary/**/*"
             CopyToOutputDirectory="PreserveNewest"
             Link="LensLibrary/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/Brand/CompanyLogo.png"
                      LogicalName="OptilandWorkbench.App.Assets.Brand.CompanyLogo.png" />
    <EmbeddedResource Include="Assets/DrawingTemplates/*.xml">
      <LogicalName>OptilandWorkbench.App.Assets.DrawingTemplates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Assets/Fonts/OFL-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/Fonts/NotoSansCJKsc-Regular.otf"
                      LogicalName="OptilandWorkbench.App.Assets.Fonts.NotoSansCJKsc-Regular.otf" />
    <EmbeddedResource Include="Assets/Icons/lucide-icon-nodes.json"
                      LogicalName="OptilandWorkbench.App.Assets.Icons.lucide-icon-nodes.json" />
    <EmbeddedResource Include="Assets/Icons/game-icons-isekai.json"
                      LogicalName="OptilandWorkbench.App.Assets.Icons.game-icons-isekai.json" />
    <EmbeddedResource Include="Assets/Icons/farm-fresh-icons.json"
                      LogicalName="OptilandWorkbench.App.Assets.Icons.farm-fresh-icons.json" />
    <EmbeddedResource Include="Assets/Icons/FarmFresh32/*.png">
      <LogicalName>OptilandWorkbench.App.Assets.Icons.FarmFresh32.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <AvaloniaResource Include="Assets/Fonts/fusion-pixel-10px-monospaced-zh_hans.ttf" />
    <Content Include="Assets/Icons/GAME-ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Icons/FARM-FRESH-ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/FUSION-PIXEL-FONT-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(WindowsPackage)' == 'true'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Optical System Design</AssemblyTitle>
    <Product>Optical System Design</Product>
    <Company>S.T.A.R. Labs</Company>
    <Description>Optical system design and analysis software by S.T.A.R. Labs.</Description>
    <ApplicationIcon>Assets/Brand/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
