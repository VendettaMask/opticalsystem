! 45 degree apex prism
! FSI Feb 3, 1999

! front face vertices
V 1  1 -1 0
V 2 -1 -1 0
V 3  1  1 0
V 4 -1  1 0

! back face vertices
V 5  1  2.4142 3.4142
V 6 -1  2.4142 3.4142
V 7  1  1      4.8284
V 8 -1  1      4.8284

! Front face rectangle
R 1 2 4 3 0

! Back face rectangle
R 5 6 8 7 0

! Top rectangle
R 3 4 6 5 0

! Bottom rectangle (reflective)
R 1 2 8 7 1

! left side rectangle
R 1 3 5 7 0

! right side rectangle
R 2 4 6 8 0

