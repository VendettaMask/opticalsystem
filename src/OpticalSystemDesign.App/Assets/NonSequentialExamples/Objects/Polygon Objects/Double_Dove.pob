! A double dove prism for BK7 at 0.55 microns (n=1.5185224)
! FSI Mar 26, 1999

!Total z extent for other index: 
!  0.5 + {([SQRT(n^2-sin45^2)+sin45]/[SQRT(n^2-sin45^2)-sin45])+1}/2 + 0.5

! common vertices
V 1  0.5  0 0
V 2 -0.5  0 0
V 3  0.5 0.0 2.11052
V 4 -0.5 0.0 2.11052

! top vertices
V 5  0.5 0.5 1.61052
V 6 -0.5 0.5 1.61052
V 7  0.5 0.5 0.5
V 8 -0.5 0.5 0.5

! bottom vertices
V 9   0.5 -0.5 1.61052
V 10 -0.5 -0.5 1.61052
V 11  0.5 -0.5 0.5
V 12 -0.5 -0.5 0.5

!Upper prism
! Front face  rectangle
R 1 2 8 7 0

! Back face rectangle
R 3 4 6 5 0

! Top rectangle
R 7 5 6 8 0

! Bottom rectangle, note this is reflective
R 1 2 4 3 1

! facing side rectangle
R 1 7 5 3 0

! rear side rectangle
R 2 8 6 4 0


!Lower prism
! Front face  rectangle
R 1 2 12 11 0

! Back face rectangle
R 3 4 10 9 0

! Bottom rectangle
R 11 9 10 12 0

! Top rectangle, note this is reflective
R 1 2 4 3 1

! facing side rectangle
R 1 3 9 11 0

! rear side rectangle
R 2 4 10 12 0
