<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OpticalSystemDesign.Application\OpticalSystemDesign.Application.csproj" />
    <ProjectReference Include="../OpticalSystemDesign.Modules/OpticalSystemDesign.Modules.csproj" />
    <ProjectReference Include="../../labs/InitialStructure/src/OpticalSystemDesign.InitialStructure.Engine/OpticalSystemDesign.InitialStructure.Engine.csproj" />
    <ProjectReference Include="../../labs/InitialStructure/src/OpticalSystemDesign.InitialStructure.Persistence/OpticalSystemDesign.InitialStructure.Persistence.csproj" />
    <ProjectReference Include="../../labs/CoatingDesign/src/OpticalSystemDesign.CoatingDesign.Engine/OpticalSystemDesign.CoatingDesign.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
    <PackageReference Include="Dock.Serializer.SystemTextJson" Version="12.0.0.2" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets/Icons/lucide-icon-nodes.json" />
    <AvaloniaResource Remove="Assets/Icons/game-icons-isekai.json" />
    <AvaloniaResource Remove="Assets/Icons/farm-fresh-icons.json" />
    <AvaloniaResource Remove="Assets/Icons/FarmFresh32/*.png" />
    <AvaloniaResource Include="Assets/Author.jpg" />
    <AvaloniaResource Include="Assets/Brand/AppIcon.png" />
    <AvaloniaResource Include="Assets/Brand/Splash.png" />
    <AvaloniaResource Include="../../docs/assets/readme/workbench-light.png"
                      Link="Assets/UserGuide/workbench-light.png" />
    <Content Include="Assets/Brand/AppIcon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/Splash.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Brand/AppIcon.icns" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/LensLibrary/**/*"
             CopyToOutputDirectory="PreserveNewest"
             Link="LensLibrary/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="Assets/SequentialExamples/**/*"
             Exclude="Assets/SequentialExamples/index.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Link="Examples/Sequential/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets/SequentialExamples/index.json"
                      LogicalName="OpticalSystemDesign.App.SequentialExamples.index.json" />
    <EmbeddedResource Include="Assets/Updates/ota-public-key.pem"
                      LogicalName="OpticalSystemDesign.App.Updates.PublicKey" />
    <EmbeddedResource Include="Assets/Brand/CompanyLogo.png"
                      LogicalName="OpticalSystemDesign.App.Assets.Brand.CompanyLogo.png" />
    <EmbeddedResource Include="Assets/DrawingTemplates/*.xml">
      <LogicalName>OpticalSystemDesign.App.Assets.DrawingTemplates.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <Content Include="Assets/Fonts/OFL-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets/Fonts/NotoSansCJKsc-Regular.otf"
                      LogicalName="OpticalSystemDesign.App.Assets.Fonts.NotoSansCJKsc-Regular.otf" />
    <EmbeddedResource Include="Assets/Icons/lucide-icon-nodes.json"
                      LogicalName="OpticalSystemDesign.App.Assets.Icons.lucide-icon-nodes.json" />
    <EmbeddedResource Include="Assets/Icons/game-icons-isekai.json"
                      LogicalName="OpticalSystemDesign.App.Assets.Icons.game-icons-isekai.json" />
    <EmbeddedResource Include="Assets/Icons/farm-fresh-icons.json"
                      LogicalName="OpticalSystemDesign.App.Assets.Icons.farm-fresh-icons.json" />
    <EmbeddedResource Include="Assets/Icons/FarmFresh32/*.png">
      <LogicalName>OpticalSystemDesign.App.Assets.Icons.FarmFresh32.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <AvaloniaResource Include="Assets/Fonts/fusion-pixel-10px-monospaced-zh_hans.ttf" />
    <AvaloniaResource Include="Assets/Fonts/Typography/**/*.ttf" />
    <AvaloniaResource Include="Assets/Fonts/Typography/**/*.otf" />
    <Content Include="Assets/Fonts/Typography/*-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets/Icons/GAME-ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Icons/FARM-FRESH-ICONS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/Fonts/FUSION-PIXEL-FONT-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third_party/coating-reference/*LICENSE.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third_party/coating-reference/*NOTICE.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third_party/autolens/*.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../third_party/ilgpu/*.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OtaBuildSequence Condition="'$(GITHUB_ACTIONS)' == 'true'">$(GITHUB_RUN_ID)</OtaBuildSequence>
    <OtaBuildSequence Condition="'$(OtaBuildSequence)' == ''">0</OtaBuildSequence>
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(WindowsPackage)' == 'true'">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>Optical System Design</AssemblyTitle>
    <Product>Optical System Design</Product>
    <Company>S.T.A.R. Labs</Company>
    <Description>Optical system design and analysis software by S.T.A.R. Labs.</Description>
    <ApplicationIcon>Assets/Brand/AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="OtaBuildSequence" Value="$(OtaBuildSequence)" />
  </ItemGroup>

</Project>
