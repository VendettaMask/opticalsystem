  "repairs": [
    {
      "id": "C06",
      "path": "Focal and afocal Huygens phase",
      "change": "Multiply geometric propagation wavenumber by image refractive index; do not multiply optical OPD again",
      "referenceMediumConvention": "Wavelength and refractive index share the same reference medium; Zemax system-air wavelength is not universally vacuum wavelength"
    },
    {
      "id": "C07",
      "path": "Shared polychromatic PSF synthesis and default MTF",
      "change": "Use configured relative flux times squared shortest/selected wavelength ratio; share ideal-peak normalization exactly once; transform summed physical intensity before taking MTF magnitude",
      "scope": "Existing shared spectral contract unified across PSF, MTF and Huygens energy consumers; energy-normalized image-simulation kernels retain their separate contract"
    },
    {
      "id": "C08",
      "path": "Polychromatic physical image registration",
      "change": "Evaluate all colors on one selected-primary or first-selected reference grid; optional geometric centroid also uses one common grid; preserve lateral color"
    },
    {
      "id": "C09",
      "path": "Paraxial reference sphere radius",
      "change": "Measure chief intercept from the image-vertex-anchored paraxial pupil reference in one global frame",
      "scope": "Formal scalar paraxial distance remains global-Z axial; arbitrary aberrated 3-D pupil, tilt, decenter and folded systems are not certified"
    }
  ],
