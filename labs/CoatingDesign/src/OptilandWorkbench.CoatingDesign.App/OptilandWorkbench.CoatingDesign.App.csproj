    <EmbeddedResource Include="../../../../src/OptilandWorkbench.App/Assets/Icons/FarmFresh32/*.png" LogicalName="OptilandWorkbench.App.Assets.Icons.FarmFresh32.%(Filename)%(Extension)" />
    <Content Include="../../../../src/OptilandWorkbench.App/Assets/Icons/*LICENSE.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../src/OptilandWorkbench.App/Assets/Fonts/FUSION-PIXEL-FONT-OFL.txt" Link="Licenses/FUSION-PIXEL-FONT-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../third_party/coating-reference/*LICENSE.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../../third_party/coating-reference/*NOTICE.txt" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
