    <ProjectReference Include="../OptilandWorkbench.CoatingDesign.Engine/OptilandWorkbench.CoatingDesign.Engine.csproj" />
    <ProjectReference Include="../../../../src/OptilandWorkbench.Application/OptilandWorkbench.Application.csproj" />
    <!-- Single-source semantic tokens; no reference to the formal executable or its state. -->
    <Compile Include="../../../../src/OptilandWorkbench.App/Controls/UiDensity.cs" Link="Shared/UiDensity.cs" />
    <Compile Include="../../../../src/OptilandWorkbench.App/Theming/*.cs" Link="Shared/Theming/%(Filename)%(Extension)" />
    <Compile Include="../../../../src/OptilandWorkbench.App/BrandAssets.cs" Link="Shared/BrandAssets.cs" />
    <Compile Include="../../../../src/OptilandWorkbench.App/Services/ThemeLayoutResources.cs" Link="Shared/ThemeLayoutResources.cs" />
    <Compile Include="../../../../src/OptilandWorkbench.App/Services/ThemeAssetBindings.cs" Link="Shared/ThemeAssetBindings.cs" />
    <EmbeddedResource Include="../../../../src/OptilandWorkbench.App/Assets/Brand/CompanyLogo.png" LogicalName="OptilandWorkbench.App.Assets.Brand.CompanyLogo.png" />
    <Compile Include="../../../../src/OptilandWorkbench.App/Controls/LocalIcon.cs" Link="Shared/LocalIcon.cs" />
    <Compile Include="../../../../src/OptilandWorkbench.App/Controls/ControlAvailability.cs" Link="Shared/ControlAvailability.cs" />
    <Compile Include="../../../../src/OptilandWorkbench.App/Services/ThemeResourceBindings.cs" Link="Shared/ThemeResourceBindings.cs" />
